# The sima container image: the executor host a run's workers are launched as,
# and the orchestrator a migrated run is driven by.
#
# Two stages. The build stage compiles both binaries against bookworm's glibc
# so they run on the matching runtime stage — the development host's glibc is
# newer than any stable base, so they are built inside. The runtime stage
# carries the Vulkan loader and the Mesa ICDs (Intel and AMD), baked. NVIDIA
# user-space libraries are not baked: they must match the host kernel driver,
# and the host's nvidia-container-toolkit injects them at container start
# (--gpus all, or CDI).
#
# `sima-worker` stays the entrypoint, so a worker starts exactly as it always
# has. `sima` is on the path beside it, because a machine rented to host a
# migrated run drives it from inside this image: the far side runs `sima run`,
# `sima sync-serve`, and `sima follow-serve` there.

FROM rust:1.92-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release -p sima-worker -p sima

FROM debian:bookworm-slim AS runtime
# libxext6 and libglvnd0 are runtime dependencies of the NVIDIA Vulkan ICD
# (libGLX_nvidia.so.0): the host's container toolkit injects the driver
# libraries but not these X11/GL dispatch libraries, and without them the
# loader silently falls back to llvmpipe on GPU hosts.
#
# openssh-client is what a migrated run reaches its own destination with; a
# migration onto a rented machine also spawns `sima sync-serve` back over the
# hop it arrived on.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libvulkan1 mesa-vulkan-drivers libxext6 libglvnd0 openssh-client \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/sima-worker /usr/local/bin/sima-worker
COPY --from=build /src/target/release/sima /usr/local/bin/sima
ENTRYPOINT ["sima-worker"]
